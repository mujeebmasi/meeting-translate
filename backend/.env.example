# Copy to .env and fill in your local Postgres password (not "postgres").
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/meet_translate?schema=public"

# Fish Audio: the English translated voice, and speech-to-text for English
# speakers. https://fish.audio/app/api-keys/
FISH_API_KEY=

# The local speech-to-text service for Hindi/Telugu/Tamil/Kannada (../asr).
# Default shown; only change it if you run that service somewhere else.
# ASR_URL=http://localhost:5001

# Translation: https://platform.deepseek.com (free token grant on signup,
# no card). translate.service.ts calls it through the Anthropic SDK, since
# DeepSeek's API accepts requests in Claude's shape at a different base URL
# -- but the env vars here are named for DeepSeek, not Anthropic.
DEEPSEEK_API_KEY=

# Optional
# FISH_BASE_URL=       # only used by fish.service.spec.ts, to point at a fake server
# DEEPSEEK_BASE_URL=    # same, for translate.service.spec.ts

# Not really optional: without this, Fish picks a different, random default
# voice on every call, so consecutive sentences sound like different people.
# 5c966a4880af40bf9ff595bc60178b56 = Fish's public "Professional Announcer"
# voice (clear, calm) -- browse others at https://fish.audio/discovery
FISH_VOICE_ID=5c966a4880af40bf9ff595bc60178b56
# FISH_TTS_MODEL=
# PORT=4000

# Set to 1 to run with fake captions instead of real speech/translation calls.
# MOCK=1

FRONTEND_URL=http://localhost:3000
